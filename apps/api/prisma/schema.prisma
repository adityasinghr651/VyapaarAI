datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ACCOUNTANT
  STAFF
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum GstTaxType {
  INTRA_STATE
  INTER_STATE
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum ConversationMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Organization {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  email                 String?
  phone                 String?
  address               String?
  gstin                 String?
  pan                   String?
  stateCode             String?
  whatsappPhoneNumberId String?               @unique
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  users                 User[]
  customers             Customer[]
  products              Product[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  invoiceSequences      InvoiceSequence[]
  auditLogs             AuditLog[]
  conversationSessions  ConversationSession[]
  conversationMessages  ConversationMessage[]
  pendingApprovals      PendingApproval[]

  @@map("organizations")
}

model User {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Organization      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email              String            @unique
  password           String
  name               String
  role               Role              @default(STAFF)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  auditLogs          AuditLog[]
  requestedApprovals PendingApproval[] @relation("ApprovalRequester")
  decidedApprovals   PendingApproval[] @relation("ApprovalDecider")

  @@index([tenantId])
  @@index([tenantId, role])
  @@map("users")
}

model Customer {
  id        String       @id @default(uuid())
  tenantId  String
  tenant    Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  email     String?
  phone     String?
  address   String?
  gstin     String?
  stateCode String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  invoices  Invoice[]

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("customers")
}

model Product {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  sku          String?
  hsnCode      String?
  price        Decimal       @db.Decimal(12, 2)
  gstRate      Decimal       @default(18.0) @db.Decimal(5, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  invoiceItems InvoiceItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("products")
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Organization  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceNumber  String
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  gstAmount      Decimal       @db.Decimal(12, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  taxType        GstTaxType    @default(INTRA_STATE)
  status         InvoiceStatus @default(DRAFT)
  notes          String?
  pdfStorageKey  String?
  pdfChecksum    String?
  pdfGeneratedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  items          InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  description String?
  hsnCode     String?
  quantity    Int
  price       Decimal      @db.Decimal(12, 2)
  gstRate     Decimal      @db.Decimal(5, 2)
  gstAmount   Decimal      @db.Decimal(12, 2)
  total       Decimal      @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, productId])
  @@map("invoice_items")
}

model AuditLog {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  requestId  String?
  traceId    String?
  metadata   Json
  createdAt  DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model InvoiceSequence {
  tenantId String
  tenant   Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  year     Int
  sequence Int          @default(0)

  @@id([tenantId, year])
  @@map("invoice_sequences")
}

model ConversationSession {
  id                String                @id @default(uuid())
  tenantId          String
  tenant            Organization          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channel           String                @default("WHATSAPP")
  externalContactId String
  contactName       String?
  state             Json
  lastMessageAt     DateTime?
  expiresAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  messages          ConversationMessage[]

  @@unique([tenantId, channel, externalContactId])
  @@index([tenantId, lastMessageAt])
  @@map("conversation_sessions")
}

model ConversationMessage {
  id                String                    @id @default(uuid())
  tenantId          String
  tenant            Organization              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId         String
  session           ConversationSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  providerMessageId String
  direction         ConversationDirection
  status            ConversationMessageStatus
  messageType       String
  body              String?
  payload           Json
  occurredAt        DateTime
  createdAt         DateTime                  @default(now())

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, sessionId, occurredAt])
  @@map("conversation_messages")
}

model PendingApproval {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Organization   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workflowType  String
  entityType    String
  entityId      String?
  payload       Json
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote  String?
  expiresAt     DateTime?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([requestedById])
  @@index([decidedById])
  @@map("pending_approvals")
}
