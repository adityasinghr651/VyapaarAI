# Environment configurations for VyapaarAI development

# Database connection URL (runs via Docker Compose PostgreSQL by default)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/vyapaarai_dev?schema=public"

# JSON Web Token Secret (used for signing authentication sessions)
JWT_SECRET="super-secret-development-key-change-in-production-12345678"

# Port mapping for NestJS backend application
PORT=4000

# Application environment
NODE_ENV=development
